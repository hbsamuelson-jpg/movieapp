# Copy this file to .env.local and fill in your keys. See README.md for where each one comes from.
# With everything blank the app still runs: names and ratings on one device, 150 built-in movies, no posters.

# --- TMDB (movie search, posters, MPAA ratings) ---
# Either the short "API Key" (v3) or the long "API Read Access Token" (v4) works.
VITE_TMDB_API_KEY=

# --- Firebase (shares names and ratings between devices) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to true to ignore the Firebase keys and run on-device only.
VITE_DEMO_MODE=false

# --- AI assistant (optional; server-side only) ---
# Set these in Vercel, not here, and never with a VITE_ prefix: this key must stay secret.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_DAILY_CAP=60
