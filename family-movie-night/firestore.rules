rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app signs every device in anonymously, so "signed in" here means "using the app".
    // There are no personal accounts: anyone who can open the site can read and change
    // the shared names, ratings and shortlist. Share the link only with people you trust.
    match /groups/{spaceId} {
      allow read, write: if request.auth != null;
      match /movies/{movieId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
