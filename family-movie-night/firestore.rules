rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each person's own pointer to the group they are in.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A group of people who share ratings. The document id is the invite code.
    match /groups/{groupId} {
      // You can open a group only if you know its code; nobody can list groups.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // Members can update it; a newcomer can update it only by adding themselves.
      allow update: if signedIn() &&
        (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);

      match /movies/{movieId} {
        allow read, write: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
  }
}
